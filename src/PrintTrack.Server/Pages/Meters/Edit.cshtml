@page
@model PrintTrack.Server.Pages.Meters.EditModel
@{ ViewData["Title"] = $"SNMP · {Model.Printer.Name}"; }

<h3 class="mb-1">Contador SNMP</h3>
<p class="text-muted">
    <code>@Model.Printer.Name</code>
    @if (Model.Printer.WorkstationName is { Length: > 0 }) { <span>· @Model.Printer.WorkstationName</span> }
    @if (Model.Cfg?.DeviceName is { Length: > 0 }) { <span>· hostname SNMP: <strong>@Model.Cfg.DeviceName</strong></span> }
    @if (Model.Cfg?.DeviceDescr is { Length: > 0 }) { <br /><span class="small">@Model.Cfg.DeviceDescr</span> }
</p>

<div class="row g-4">
    <div class="col-lg-6">
        <div class="card shadow-sm"><div class="card-body">
            <form method="post" asp-page-handler="Save">
                <input type="hidden" asp-for="Input.PrinterId" />
                <div asp-validation-summary="All" class="text-danger small mb-2"></div>

                <div class="form-check mb-3">
                    <input asp-for="Input.Enabled" class="form-check-input" />
                    <label asp-for="Input.Enabled" class="form-check-label">Sondear este equipo por SNMP</label>
                </div>

                <div class="row">
                    <div class="col-8 mb-2"><label class="form-label">Host / IP</label>
                        <input asp-for="Input.Host" class="form-control" placeholder="10.0.12.34" /></div>
                    <div class="col-4 mb-2"><label class="form-label">Puerto</label>
                        <input asp-for="Input.Port" type="number" class="form-control" /></div>
                </div>

                <div class="row">
                    <div class="col-5 mb-2"><label class="form-label">Versión</label>
                        <select asp-for="Input.Version" class="form-select"
                                asp-items="Html.GetEnumSelectList<PrintTrack.Server.Data.SnmpVersion>()"></select></div>
                    <div class="col-7 mb-2"><label class="form-label">Community (v1/v2c)</label>
                        <input asp-for="Input.Community" class="form-control" /></div>
                </div>

                <details class="mb-2">
                    <summary class="small text-muted">SNMP v3 (opcional)</summary>
                    <div class="row mt-2">
                        <div class="col-6 mb-2"><label class="form-label">Usuario</label>
                            <input asp-for="Input.SecurityName" class="form-control form-control-sm" /></div>
                        <div class="col-3 mb-2"><label class="form-label">Auth</label>
                            <select asp-for="Input.AuthProtocol" class="form-select form-select-sm">
                                <option value="">—</option><option>MD5</option><option>SHA</option></select></div>
                        <div class="col-3 mb-2"><label class="form-label">Priv</label>
                            <select asp-for="Input.PrivProtocol" class="form-select form-select-sm">
                                <option value="">—</option><option>DES</option><option>AES</option></select></div>
                        <div class="col-6 mb-2"><label class="form-label">Auth pass</label>
                            <input asp-for="Input.AuthPassword" type="password" class="form-control form-control-sm" /></div>
                        <div class="col-6 mb-2"><label class="form-label">Priv pass</label>
                            <input asp-for="Input.PrivPassword" type="password" class="form-control form-control-sm" /></div>
                    </div>
                </details>

                <hr />
                <div class="mb-2"><label class="form-label">OID total (páginas)</label>
                    <input asp-for="Input.OidTotal" class="form-control font-monospace" /></div>
                <div class="row">
                    <div class="col mb-2"><label class="form-label">OID B/N</label>
                        <input asp-for="Input.OidMono" class="form-control form-control-sm font-monospace" /></div>
                    <div class="col mb-2"><label class="form-label">OID color</label>
                        <input asp-for="Input.OidColor" class="form-control form-control-sm font-monospace" /></div>
                </div>
                <div class="form-text mb-3">
                    Sin OID de B/N y color, solo se guarda el total. Para HP, OIDs frecuentes (varían por modelo):<br />
                    total impresas mono <code>1.3.6.1.4.1.11.2.3.9.4.2.1.1.16.1.1.2.1.0</code><br />
                    total impresas color <code>1.3.6.1.4.1.11.2.3.9.4.2.1.1.16.1.1.2.2.0</code><br />
                    Probalas abajo con "Probar OID" antes de guardarlas.
                </div>

                <button class="btn btn-primary" asp-page-handler="Save">Guardar</button>
                <button class="btn btn-outline-primary" asp-page-handler="Poll">Guardar y sondear ahora</button>
                <a href="/Meters" class="btn btn-link">Volver</a>
            </form>

            <hr />
            <form method="post" asp-page-handler="TestOid" asp-route-id="@Model.Input.PrinterId" class="row g-2">
                <div class="col-8">
                    <label class="form-label small">Probar un OID (con el host ya guardado)</label>
                    <input asp-for="TestOid" class="form-control form-control-sm font-monospace" placeholder="1.3.6.1..." />
                </div>
                <div class="col-4 d-flex align-items-end">
                    <button class="btn btn-outline-secondary btn-sm w-100">Probar OID</button>
                </div>
            </form>
            @if (Model.OidTestResult is not null)
            {
                <div class="alert alert-info small mt-2 font-monospace mb-0">@Model.OidTestResult</div>
            }
        </div></div>
    </div>

    <div class="col-lg-6">
        <div class="card shadow-sm mb-3"><div class="card-body">
            <h6>Agregar lectura manual</h6>
            <form method="post" asp-page-handler="Manual" asp-route-id="@Model.Input.PrinterId" class="row g-2">
                <div class="col-4"><label class="form-label small">Fecha</label>
                    <input asp-for="Manual.Date" type="date" class="form-control form-control-sm" /></div>
                <div class="col-4"><label class="form-label small">Total</label>
                    <input asp-for="Manual.Total" type="number" class="form-control form-control-sm" /></div>
                <div class="col-2"><label class="form-label small">B/N</label>
                    <input asp-for="Manual.Mono" type="number" class="form-control form-control-sm" /></div>
                <div class="col-2"><label class="form-label small">Color</label>
                    <input asp-for="Manual.Color" type="number" class="form-control form-control-sm" /></div>
                <div class="col-9"><input asp-for="Manual.Note" class="form-control form-control-sm" placeholder="nota" /></div>
                <div class="col-3"><button class="btn btn-outline-secondary btn-sm w-100">Agregar</button></div>
            </form>
        </div></div>

        <div class="card shadow-sm">
            <div class="card-header">Lecturas recientes</div>
            <div class="table-responsive">
                <table class="table table-sm mb-0">
                    <thead><tr><th>Fecha</th><th>Origen</th><th class="text-end">Total</th>
                        <th class="text-end">B/N</th><th class="text-end">Color</th><th></th></tr></thead>
                    <tbody>
                    @foreach (var r in Model.Readings)
                    {
                        <tr>
                            <td class="small text-nowrap">@Ui.Dt(r.TakenAt)</td>
                            <td class="small">@(r.Source == PrintTrack.Server.Data.MeterSource.Manual ? "manual" : "SNMP")</td>
                            <td class="text-end">@r.Total.ToString("N0")</td>
                            <td class="text-end">@(r.Mono?.ToString("N0") ?? "—")</td>
                            <td class="text-end">@(r.Color?.ToString("N0") ?? "—")</td>
                            <td class="text-end">
                                <form method="post" asp-page-handler="DeleteReading"
                                      asp-route-id="@Model.Input.PrinterId" asp-route-readingId="@r.Id"
                                      onsubmit="return confirm('¿Borrar esta lectura?');">
                                    <button class="btn btn-link btn-sm text-danger p-0">×</button>
                                </form>
                            </td>
                        </tr>
                    }
                    @if (Model.Readings.Count == 0)
                    {
                        <tr><td colspan="6" class="text-center text-muted py-3">Sin lecturas.</td></tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
