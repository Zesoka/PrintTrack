@page
@model PrintTrack.Server.Pages.Jobs.IndexModel
@{ ViewData["Title"] = "Trabajos"; }

<h3 class="mb-3">Trabajos de impresión</h3>

@{
    var qs = $"user={Model.UserFilter}&printer={Model.Printer}&status={Model.Status}"
           + $"&siteId={Model.SiteId}&departmentId={Model.DepartmentId}"
           + $"&from={Model.From?.ToString("yyyy-MM-dd")}&to={Model.To?.ToString("yyyy-MM-dd")}";
}
<form method="get" class="row g-2 mb-3 align-items-end">
    <div class="col-auto"><input name="user" value="@Model.UserFilter" class="form-control form-control-sm" placeholder="Usuario" /></div>
    <div class="col-auto"><input name="printer" value="@Model.Printer" class="form-control form-control-sm" placeholder="Impresora" /></div>
    <div class="col-auto">
        <select name="siteId" class="form-select form-select-sm">
            <option value="">— Sede —</option>
            @foreach (var s in Model.Sites) { <option value="@s.Value" selected="@(Model.SiteId?.ToString() == s.Value)">@s.Text</option> }
        </select>
    </div>
    <div class="col-auto">
        <select name="departmentId" class="form-select form-select-sm">
            <option value="">— Área —</option>
            @foreach (var d in Model.Departments) { <option value="@d.Value" selected="@(Model.DepartmentId?.ToString() == d.Value)">@d.Text</option> }
        </select>
    </div>
    <div class="col-auto">
        <select name="status" class="form-select form-select-sm">
            <option value="">— Estado —</option>
            @foreach (var s in Enum.GetValues<PrintJobStatus>())
            {
                <option value="@s" selected="@(Model.Status == s)">@Ui.StatusText(s)</option>
            }
        </select>
    </div>
    <div class="col-auto"><label class="form-label small mb-0">Desde</label>
        <input name="from" type="date" value="@Model.From?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" /></div>
    <div class="col-auto"><label class="form-label small mb-0">Hasta</label>
        <input name="to" type="date" value="@Model.To?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" /></div>
    <div class="col-auto">
        <button class="btn btn-outline-secondary btn-sm">Filtrar</button>
        <a href="?handler=Export&@qs" class="btn btn-outline-primary btn-sm">Exportar CSV</a>
        @if (Model.CanWrite)
        {
            <a href="/Jobs/Import" class="btn btn-outline-success btn-sm">Importar de impresora</a>
        }
        <a href="/Jobs" class="btn btn-link btn-sm">Limpiar</a>
    </div>
</form>

<p class="text-muted small">@Model.Total trabajos · @Model.TotalSheets hojas impresas (con los filtros actuales)</p>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-sm mb-0 align-middle">
            <thead><tr>
                <th>Fecha</th><th>Sede</th><th>Área</th><th>Usuario</th><th>Documento</th><th>Impresora</th><th>Equipo</th>
                <th class="text-end">Pág.</th><th class="text-end">Copias</th><th class="text-end">Hojas</th>
                <th>Color</th><th>Dúplex</th><th>Estado</th>
            </tr></thead>
            <tbody>
            @foreach (var j in Model.Jobs)
            {
                <tr>
                    <td class="small text-nowrap">@Ui.Dt(j.SubmittedAt)</td>
                    <td class="small">@(j.Site?.Name ?? "—")</td>
                    <td class="small">@(j.EndUser.Department?.Name ?? "—")</td>
                    <td>@j.UserNameRaw</td>
                    <td class="text-truncate" style="max-width:220px" title="@j.DocumentName">@j.DocumentName</td>
                    <td class="small">@j.PrinterNameRaw</td>
                    <td class="small text-muted">@j.WorkstationName</td>
                    @{ var noPages = j.Pages == 0; var noSheets = j.Sheets == 0; }
                    <td class="text-end">@(noPages ? "s/d" : j.Pages.ToString())</td>
                    <td class="text-end">@j.Copies</td>
                    <td class="text-end fw-semibold">@(noSheets ? "s/d" : j.Sheets.ToString())</td>
                    <td class="small">@(j.Color == PrintTrack.Shared.ColorMode.Unknown ? "s/d" : Ui.ColorText(j.Color))</td>
                    <td class="small">@(j.Duplex == PrintTrack.Shared.DuplexMode.Unknown ? "s/d" : Ui.DuplexText(j.Duplex))</td>
                    <td><span class="badge bg-@Ui.StatusBadge(j.Status)">@Ui.StatusText(j.Status)</span></td>
                </tr>
            }
            @if (Model.Jobs.Count == 0)
            {
                <tr><td colspan="13" class="text-center text-muted py-3">Sin trabajos.</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>

@if (Model.Pages > 1)
{
    <nav class="mt-3"><ul class="pagination pagination-sm">
        @for (var i = 1; i <= Model.Pages && i <= 30; i++)
        {
            <li class="page-item @(i == Model.P ? "active" : "")">
                <a class="page-link" href="?@qs&p=@i">@i</a>
            </li>
        }
    </ul></nav>
}
