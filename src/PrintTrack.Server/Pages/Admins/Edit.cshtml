@page
@model PrintTrack.Server.Pages.Admins.EditModel
@using PrintTrack.Server.Data
@{ ViewData["Title"] = $"Admin · {Model.Target.UserName}"; }

<h3 class="mb-1">Editar administrador</h3>
<p class="text-muted"><code>@Model.Target.UserName</code></p>

<div class="row"><div class="col-lg-6">
<div class="card shadow-sm"><div class="card-body">
    <form method="post">
        <input type="hidden" name="id" value="@Model.Target.Id" />
        <div asp-validation-summary="All" class="text-danger small mb-2"></div>

        <div class="mb-2"><label class="form-label">Rol</label>
            <select asp-for="Role" class="form-select">
                <option value="@AdminRoles.SuperAdmin">SuperAdmin</option>
                <option value="@AdminRoles.SedeAdmin">SedeAdmin</option>
                <option value="@AdminRoles.SedeViewer">SedeViewer</option>
            </select>
        </div>

        <div class="mb-3">
            <label class="form-label">Sedes (ignorado si es SuperAdmin)</label>
            <div class="border rounded p-2" style="max-height:220px;overflow:auto">
                @foreach (var s in Model.Sites)
                {
                    <div class="form-check">
                        <input type="checkbox" class="form-check-input" name="SiteIds" value="@s.Id" id="s@(s.Id)"
                               checked="@Model.SiteIds.Contains(s.Id)" />
                        <label class="form-check-label" for="s@(s.Id)">@s.Name</label>
                    </div>
                }
            </div>
        </div>

        <div class="mb-3"><label class="form-label">Nueva contraseña (dejar vacío para no cambiar)</label>
            <input asp-for="NewPassword" type="password" class="form-control" /></div>

        <button class="btn btn-primary">Guardar</button>
        <a href="/Admins" class="btn btn-link">Volver</a>
    </form>
</div></div>
</div></div>
