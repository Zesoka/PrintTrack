@using Microsoft.AspNetCore.Identity
@using PrintTrack.Server.Data
@inject SignInManager<AdminUser> SignInManager
@{
    var signedIn = SignInManager.IsSignedIn(User);
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Santa Catalina</title>
    <link rel="icon" type="image/jpeg" href="/favicon.jpg" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <style>
        :root {
            --brand-gray: #6d6e71;
            --brand-gray-dark: #58595b;
            --brand-orange: #e8833c;
            --bs-primary: var(--brand-orange);
            --bs-primary-rgb: 232,131,60;
        }
        body { background:#f6f7f9; }
        .navbar-brand { font-weight:700; letter-spacing:.3px; }
        .navbar.navbar-dark.bg-brand { background:var(--brand-gray-dark); border-bottom:3px solid var(--brand-orange); }
        .navbar.navbar-dark.bg-brand .nav-link:hover,
        .navbar.navbar-dark.bg-brand .nav-link:focus { color:#ffd9b3; }
        .kpi { font-size:1.9rem; font-weight:700; }
        .table-sm td, .table-sm th { padding:.4rem .5rem; }
        main { padding-bottom:3rem; }
        .btn-primary { background-color:var(--brand-orange); border-color:var(--brand-orange); }
        .btn-primary:hover, .btn-primary:focus { background-color:#d6742f; border-color:#d6742f; }
        .btn-outline-primary { color:var(--brand-orange); border-color:var(--brand-orange); }
        .btn-outline-primary:hover { background-color:var(--brand-orange); border-color:var(--brand-orange); }
        a { color:#c9662a; }
    </style>
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark bg-brand">
    <div class="container">
        <a class="navbar-brand d-flex align-items-center" href="/">
            <img src="/favicon.jpg" alt="Santa Catalina" height="36" class="rounded-circle me-2" />
            <span class="lh-1">Santa Catalina<br /><small class="fw-normal" style="font-size:.6rem;opacity:.85">Auditor de impresiones</small></span>
        </a>
        @if (signedIn)
        {
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="nav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><a class="nav-link" href="/">Panel</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Jobs">Trabajos</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Users">Usuarios</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Printers">Impresoras</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Meters">Contadores</a></li>
                    <li class="nav-item"><a class="nav-link" href="/JobLog">Job Log</a></li>
                    @if (User.IsInRole(AdminRoles.SuperAdmin))
                    {
                        <li class="nav-item"><a class="nav-link" href="/Discovery">Descubrir</a></li>
                        <li class="nav-item"><a class="nav-link" href="/Catalogs">Catálogos</a></li>
                        <li class="nav-item"><a class="nav-link" href="/Admins">Administradores</a></li>
                    }
                </ul>
                <span class="navbar-text text-light me-3">
                    @User.Identity?.Name
                    @if (!User.IsInRole(AdminRoles.SuperAdmin))
                    {
                        <span class="badge bg-secondary ms-1">@(User.IsInRole(AdminRoles.SedeAdmin) ? "sede" : "solo lectura")</span>
                    }
                </span>
                <form method="post" action="/Account/Logout">
                    <button class="btn btn-outline-light btn-sm" type="submit">Salir</button>
                </form>
            </div>
        }
    </div>
</nav>
<main class="container mt-4">
    @if (TempData["Msg"] is string msg)
    {
        <div class="alert alert-success alert-dismissible fade show">@msg
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Err"] is string err)
    {
        <div class="alert alert-danger alert-dismissible fade show">@err
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @RenderBody()
</main>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
